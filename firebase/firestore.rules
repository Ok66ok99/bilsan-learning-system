rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function familyPath(familyId) { return /databases/$(database)/documents/families/$(familyId); }
    function devicePath(familyId, deviceId) {
      return /databases/$(database)/documents/families/$(familyId)/devices/$(deviceId);
    }
    function owner(familyId) {
      return signedIn() && exists(familyPath(familyId))
        && get(familyPath(familyId)).data.ownerUid == request.auth.uid;
    }
    function approvedChild(familyId) {
      return signedIn() && exists(devicePath(familyId, request.auth.uid))
        && get(devicePath(familyId, request.auth.uid)).data.approved == true
        && get(devicePath(familyId, request.auth.uid)).data.revoked != true;
    }

    // Family creation and ownership changes require trusted server Admin SDK.
    match /families/{familyId} {
      allow get: if owner(familyId);
      allow list, create, update, delete: if false;

      // Pairing approval/revocation must be performed by a trusted server.
      match /devices/{deviceId} {
        allow get, list: if owner(familyId);
        allow create, update, delete: if false;
      }

      match /lessons/{lessonId} {
        allow get, list: if owner(familyId) || approvedChild(familyId);
        allow create, update, delete: if false;
      }

      // Drawings are readable only by the parent or their owning approved child.
      // The document ID is the child's UID, preventing cross-device writes.
      // A bounded list of normalized strokes is stored as Firestore data.
      match /drawings/{deviceUid} {
        allow get: if owner(familyId) ||
          (approvedChild(familyId) && deviceUid == request.auth.uid);
        allow list: if owner(familyId);
        allow create, update: if approvedChild(familyId)
          && deviceUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['deviceUid', 'items', 'updatedAt'])
          && request.resource.data.deviceUid == request.auth.uid
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 20
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /progress/{progressId} {
        allow get: if owner(familyId) || (approvedChild(familyId) && progressId == request.auth.uid);
        allow list: if owner(familyId);
        allow create: if approvedChild(familyId)
          && progressId == request.auth.uid
          && request.resource.data.keys().hasOnly(['deviceUid', 'completedCount', 'updatedAt'])
          && request.resource.data.deviceUid == request.auth.uid
          && request.resource.data.completedCount is int
          && request.resource.data.completedCount >= 0
          && request.resource.data.completedCount <= 100000
          && request.resource.data.updatedAt == request.time;
        allow update: if approvedChild(familyId)
          && progressId == request.auth.uid
          && resource.data.deviceUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedCount', 'updatedAt'])
          && request.resource.data.completedCount is int
          && request.resource.data.completedCount >= resource.data.completedCount
          && request.resource.data.completedCount <= 100000
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /{other=**} { allow read, write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
