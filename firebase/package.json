{
  "name": "bilsan-firestore-security-tests",
  "private": true,
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore 'jest --runInBand --testPathIgnorePatterns=/functions/' --project demo-bilsan-security-test",
    "test:integration": "firebase emulators:exec --only firestore 'node --test functions/integration/*.integration.test.js' --project demo-bilsan-security-test"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^13.30.0",
    "jest": "^29.7.0"
  }
}
